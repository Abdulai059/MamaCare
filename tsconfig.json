{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@/assets": [
        "./assets"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "types.d.ts",
    "nativewind-env.d.ts"
  ]
}
